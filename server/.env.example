# Copy to .env and fill in. `docker compose` reads this file automatically.

# Absolute path on the host to the folder holding your library.
# Each immediate subfolder becomes a profile in the app.
MEDIAVAULT_MEDIA_DIR=/srv/media

# The password you type on the sign-in page in the app.
MEDIAVAULT_PASSWORD=change-me

# Signs the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it signs every device out.
MEDIAVAULT_SECRET_KEY=change-me

# Set to 1 when a TLS reverse proxy terminates HTTPS in front of the container.
MEDIAVAULT_HTTPS_ONLY=0

# Thumbnail longest edge, in pixels.
MEDIAVAULT_THUMB_SIZE=400

# Seconds before a library scan is considered stale. Raise it for very large
# libraries; deletes invalidate the cache immediately regardless.
MEDIAVAULT_SCAN_CACHE_TTL=300
