# Copy to .env and fill in. `docker compose` reads this file automatically.

# Absolute path on the host to the folder holding your library.
# Each immediate subfolder becomes a profile in the app.
# Serving several scattered folders instead? Leave this and see the commented
# multi-mount block in compose.yml.
MEDIAVAULT_MEDIA_DIR=/srv/media

# Port on the host. The container always listens on 8000 internally.
MEDIAVAULT_PORT=8000

# The password you type on the sign-in page in the app.
MEDIAVAULT_PASSWORD=change-me

# Signs the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it signs every device out.
MEDIAVAULT_SECRET_KEY=change-me

# Where deleted files go. A host path keeps them browsable from the host:
#   MEDIAVAULT_TRASH_DIR=/srv/media-trash
# Left unset, a Docker named volume is used instead — deletes survive restarts
# but are awkward to inspect.
#MEDIAVAULT_TRASH_DIR=/srv/media-trash

# How deletes are carried out:
#   auto       move to the trash, and delete outright when the trash cannot be
#              created or written (the default)
#   trash      always move to the trash; fail with an explanation if it cannot
#   permanent  always delete outright, nothing is recoverable
# `auto` exists because a media root mounted read-only, or owned by a different
# uid than the container runs as, cannot have a trash folder created inside it —
# which used to make every delete fail with a 500.
MEDIAVAULT_DELETE_MODE=auto

# Set to 1 when a TLS reverse proxy terminates HTTPS in front of the container.
MEDIAVAULT_HTTPS_ONLY=0

# Thumbnail longest edge, in pixels.
MEDIAVAULT_THUMB_SIZE=400

# Seconds before a library scan is considered stale. Raise it for very large
# libraries; deletes invalidate the cache immediately regardless.
MEDIAVAULT_SCAN_CACHE_TTL=300
